{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Automation Platform",
  "version": "0.1.0",
  "identifier": "com.automation-platform.desktop",
  "build": {
    "frontendDist": "../",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png"
    },
    "windows": [
      {
        "title": "Automation Platform",
        "width": 1280,
        "height": 800,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "targets": ["appimage", "deb"]
    },
    "externalBin": ["ap"]
  },
  "plugins": {
    "shell": {
      "scope": [
        {
          "name": "ap",
          "sidecar": true,
          "args": true
        }
      ]
    }
  }
}
