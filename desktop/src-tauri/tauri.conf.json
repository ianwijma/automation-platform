{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Automation Platform",
  "version": "0.1.0",
  "identifier": "com.automation-platform.desktop",
  "build": {
    "frontendDist": "../shell",
    "beforeBuildCommand": "bun run ../build.ts --desktop",
    "beforeDevCommand": "bun run ../build.ts --desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Automation Platform",
        "width": 1280,
        "height": 800,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": [
      "resources/ap.gz"
    ]
  }
}
